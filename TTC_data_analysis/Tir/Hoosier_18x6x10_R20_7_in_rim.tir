[MDI_HEADER]
FILE_TYPE                    = 'tir'             
FILE_VERSION                 = 3                 
FILE_FORMAT                  = 'ASCII'           
$-----------------------------------------------------------------units
[UNITS]
LENGTH                       = 'meter'           
FORCE                        = 'newton'          
ANGLE                        = 'radians'         
MASS                         = 'kg'              
TIME                         = 'second'          
PRESSURE                   = 'pascal'            
$-----------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT       = 'PAC2002'            $Tire property type
USE_MODE                   = 14.000000            $Tire use switch (IUSED)
LONGVL                     = 10.000000            $Measurement speed
VXLOW                      = 1.000000             $Below this speed forces are scaled down
TYRESIDE                   = 'LEFT'              $Mounted side of tire at vehicle/test bench
BELT_DYNAMICS              = 'NO'                 $For switching on belt dynamics
CONTACT_MODEL              = 'DEFAULT'            $Defines type of contact with the road
FE_METHOD                  = 'NO'                 $For switching to Friction ellipse for combined slip
LOCAL_SOLVER               = 'NO'                 $For using the local tire solver (default setting)
LOCAL_SOLVER_HP            = 'YES'                $For using the local tire solver (HP  setting)
FITTYP                       = 61                
$---------------------------------------------------------------tire_conditions
[TIRE_CONDITIONS]
IP                         = 83000.000000         $Inflation Pressure
IP_NOM                     = 83000.000000         $Nominal Inflation Pressure
$-------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS              = 0.2286            
WIDTH                        = 0.1524            
ASPECT_RATIO                 = 0.400000             $Nominal aspect ratio
RIM_RADIUS                   = 0.127             
RIM_WIDTH                    = 0.1778            
BOTTOMING_RADIUS             = 0.127000             $Radius at which the rim hits the road            
$--------------------------------------------------------------vertical
[VERTICAL]
VERTICAL_STIFFNESS         = 111169.017674        $Tire vertical stiffness   
VERTICAL_DAMPING           = 500.000000           $Tire vertical damping	 
DREFF                      = 0.338812             $Peak value of e.r.r.
BREFF                      = 2.932583             $Low load stiffness e.r.r.
FREFF                      = -0.117176            $High load stiffness e.r.r.
FNOMIN                       = 1110              
DYNAMIC_STIFFNESS          = 0.000000             $Dynamic stiffness rate
DYNAMIC_DAMPING            = 0.000000             $Dynamic damping
$--------------------------------------------------vertical force range
[VERTICAL_FORCE_RANGE]
FZMIN                      = -16.210000           $Minimum allowed wheel load
FZMAX                      = 1235.690000          $Maximum allowed wheel load
$-------------------------------------------------------long slip range
[LONG_SLIP_RANGE]
KPUMIN                     = -0.261000            $Minimum valid wheel slip
KPUMAX                     = 0.241000             $Maximum valid wheel slip
$------------------------------------------------------slip angle range
[SLIP_ANGLE_RANGE]
ALPMIN                     = -0.214745            $Minimum valid slip angle
ALPMAX                     = 0.214047             $Maximum valid slip angle
$-----------------------------------------------inclination angle range
[INCLINATION_ANGLE_RANGE]
CAMMIN                     = -0.000785            $Minimum valid camber angle
CAMMAX                     = 0.070337             $Maximum valid camber angle
