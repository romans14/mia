LHX                        = 1.000000             $Scale factor of Fx horizontal shift
LVX                        = 1.000000             $Scale factor of Fx vertical shift
LMUX                       = 1.000000             $Scale factor of Fx peak friction coefficient
LGAX                       = 1.000000             $Scale factor of camber for Fx
LCY                        = 1.000000             $Scale factor of Fy shape factor
LEY                        = 1.000000             $Scale factor of Fy curvature factor
LKY                        = 1.000000             $Scale factor of Fy cornering stiffness
LHY                        = 1.000000             $Scale factor of Fy horizontal shift
LVY                        = 1.000000             $Scale factor of Fy vertical shift
LMUY                       = 1.000000             $Scale factor of Fy peak friction coefficient
LGAY                       = 1.000000             $Scale factor of camber for Fy
LKG                        = 1.000000             $Scale factor of tire camber stiffness
LTR                        = 1.000000             $Scale factor of Peak of pneumatic trail
LRES                       = 1.000000             $Scale factor for offset of residual torque
LGAZ                       = 1.000000             $Scale factor of camber for Mz
LXAL                       = 1.000000             $Scale factor of alpha influence on Fx
LYKA                       = 1.000000             $Scale factor of alpha influence on Fx
LVYKA                      = 1.000000             $Scale factor of kappa induced Fy
LS                         = 1.000000             $Scale factor of Moment arm of Fx
LMX                        = 1.000000             $Scale factor of gyroscopic torque
LMY                        = 1.000000             $Scale factor of rolling resistance torque
LVMX                       = 1.000000             $Scale factor of Mx vertical shift
