$--------------------------------------------------------------------mdi_header
[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             =3
FILE_FORMAT              ='ASCII'
$-------------------------------------------------------------------------units
[UNITS]
LENGTH                     = 'meter'             
FORCE                      = 'newton'            
ANGLE                      = 'radian'            
MASS                       = 'kg'                
TIME                       = 'second'            
PRESSURE                   = 'pascal'            
$-------------------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT       = 'PAC2002'            $Tire property type
USE_MODE                   = 14.000000            $Tire use switch (IUSED)
LONGVL                     = 11.164947            $Measurement speed
VXLOW                      = 1.000000             $Below this speed forces are scaled down
TYRESIDE                   = 'RIGHT'              $Mounted side of tire at vehicle/test bench
BELT_DYNAMICS              = 'NO'                 $For switching on belt dynamics
CONTACT_MODEL              = 'DEFAULT'            $Defines type of contact with the road
FE_METHOD                  = 'NO'                 $For switching to Friction ellipse for combined slip
LOCAL_SOLVER               = 'NO'                 $For using the local tire solver (default setting)
LOCAL_SOLVER_HP            = 'YES'                $For using the local tire solver (HP  setting)
FITTYP			   = 61
$---------------------------------------------------------------tire_conditions
[TIRE_CONDITIONS]
IP                         = 82939.341560         $Inflation Pressure
IP_NOM                     = 82939.341560         $Nominal Inflation Pressure
$---------------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS            = 0.203200             $Free tire radius
WIDTH                      = 0.190500             $Nominal section width of the tire
ASPECT_RATIO               = 0.400000             $Nominal aspect ratio
RIM_RADIUS                 = 0.127000             $Radius of the rim
RIM_WIDTH                  = 0.177800             $Width of the rim
BOTTOMING_RADIUS           = 0.127000             $Radius at which the rim hits the road
$----------------------------------------------------------------------vertical
[VERTICAL]
VERTICAL_STIFFNESS         = 106991.235201        $Tire vertical stiffness
VERTICAL_DAMPING           = 500.000000           $Tire vertical damping
DREFF                      = 0.328494             $Peak value of e.r.r.
BREFF                      = 3.784477             $Low load stiffness e.r.r.
FREFF                      = 0.083311             $High load stiffness e.r.r.
FNOMIN                     = 664.399725           $Nominal wheel load
DYNAMIC_STIFFNESS          = 0.000000             $Dynamic stiffness rate
DYNAMIC_DAMPING            = 0.000000             $Dynamic damping
$---------------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                     = -0.372100            $Minimum valid wheel slip
KPUMAX                     = 0.217900             $Maximum valid wheel slip
$--------------------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                     = -0.217398            $Minimum valid slip angle
ALPMAX                     = 0.216735             $Maximum valid slip angle
$-------------------------------------------------------inclination_angle_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                     = -0.001204            $Minimum valid camber angle
CAMMAX                     = 0.070250             $Maximum valid camber angle
$----------------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                      = -32.490000           $Minimum allowed wheel load
FZMAX                      = 1264.220000          $Maximum allowed wheel load
